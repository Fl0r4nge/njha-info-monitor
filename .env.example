GONGXIN_CONFIG=/app/config.json
GONGXIN_USERNAME=
GONGXIN_PASSWORD=
# 图片验证码每次登录都会变化；仅在当次登录时临时设置。
GONGXIN_CAPTCHA=
# 企业端滑块默认自动识别并拖动，失败后最多重试 1-5 次。
GONGXIN_SLIDER_ATTEMPTS=3
LOGIN_AUTO_SAVE=1
LOGIN_TIMEOUT_MS=600000
FEISHU_WEBHOOK_URL=https://www.feishu.cn/flow/api/trigger-webhook/your-token

# ---- 佐证材料收集系统（回灌目标）----
# 形如 https://av8qmuuddzr.feishuapp.com/app/app_xxxxx
COLLECT_BASE_URL=
# 收集链接里的 slug
COLLECT_SLUG=
# 企业侧 6 位访问码（回灌字段与上传文件用）
COLLECT_ACCESS_CODE=
# 管理密钥（仅拉取 manifest 时需要）
COLLECT_ADMIN_KEY=
# 反向导出时使用的项目 UUID 或 slug；不填则使用 COLLECT_SLUG
COLLECT_PROJECT=

# ---- 佐证系统内置自动同步执行端 ----
# 佐证系统应用根地址（包含应用 base path）
COLLECT_AGENT_BASE_URL=
# 在项目管理页“一体化平台自动同步”中生成，只显示一次
COLLECT_AGENT_KEY=
# 仅在自动验证持续失败、启用 manual profile 时使用
PLATFORM_AGENT_VNC_URL=http://SERVER_IP:6080/vnc.html
# 默认无界面自动运行；manual profile 会自动覆盖为 0。
PLATFORM_AGENT_HEADLESS=1
# 仅 manual profile 需要
VNC_PASSWORD=
AGENT_POLL_MS=60000
